generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  profile             Profile?
  pet                 Pet?
  passwordResetTokens PasswordResetToken[]
  blocksCreated      UserBlock[]          @relation("BlocksCreated")
  blocksReceived     UserBlock[]          @relation("BlocksReceived")
  reportsCreated     UserReport[]         @relation("ReportsCreated")
  reportsReceived    UserReport[]         @relation("ReportsReceived")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Profile {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  name               String?
  bio                String?
  avatarUrl          String?   @map("avatar_url")
  location           String?
  latitude           Float?
  longitude          Float?
  locationUpdatedAt  DateTime? @map("location_updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Pet {
  id             String     @id @default(uuid())
  userId         String     @unique @map("user_id")
  name           String?
  age            Int?
  color          String?
  breed          String?
  favoriteToy    String?    @map("favorite_toy")
  photoUrl       String?    @map("photo_url")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          PetMedia[]
  likesSent      Like[]     @relation("LikesSent")
  likesReceived  Like[]     @relation("LikesReceived")
  passesSent     Pass[]     @relation("PassesSent")
  passesReceived Pass[]     @relation("PassesReceived")
  matchesAsA     Match[]        @relation("MatchesAsA")
  matchesAsB     Match[]        @relation("MatchesAsB")
  messagesSent   ChatMessage[]  @relation("MessagesSent")

  @@map("pets")
}

enum PetMediaType {
  photo
  video
}

model PetMedia {
  id          String       @id @default(uuid())
  petId       String       @map("pet_id")
  type        PetMediaType @default(photo)
  url         String
  publicId    String       @map("public_id")
  sortOrder   Int          @map("sort_order")
  isPrimary   Boolean      @default(false) @map("is_primary")
  durationSec Int?         @map("duration_sec")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("pet_media")
}

/// Like de una mascota hacia otra (from → to).
model Like {
  id        String   @id @default(uuid())
  fromPetId String   @map("from_pet_id")
  toPetId   String   @map("to_pet_id")
  createdAt DateTime @default(now()) @map("created_at")
  fromPet   Pet      @relation("LikesSent", fields: [fromPetId], references: [id], onDelete: Cascade)
  toPet     Pet      @relation("LikesReceived", fields: [toPetId], references: [id], onDelete: Cascade)

  @@unique([fromPetId, toPetId])
  @@index([toPetId])
  @@map("likes")
}

/// Pass / rechazo (from → to).
model Pass {
  id        String   @id @default(uuid())
  fromPetId String   @map("from_pet_id")
  toPetId   String   @map("to_pet_id")
  createdAt DateTime @default(now()) @map("created_at")
  fromPet   Pet      @relation("PassesSent", fields: [fromPetId], references: [id], onDelete: Cascade)
  toPet     Pet      @relation("PassesReceived", fields: [toPetId], references: [id], onDelete: Cascade)

  @@unique([fromPetId, toPetId])
  @@index([toPetId])
  @@map("passes")
}

/// Match mutuo. petAId < petBId (lexicográfico) para unicidad.
model Match {
  id        String        @id @default(uuid())
  petAId    String        @map("pet_a_id")
  petBId    String        @map("pet_b_id")
  createdAt DateTime      @default(now()) @map("created_at")
  petA      Pet           @relation("MatchesAsA", fields: [petAId], references: [id], onDelete: Cascade)
  petB      Pet           @relation("MatchesAsB", fields: [petBId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@unique([petAId, petBId])
  @@index([petBId])
  @@map("matches")
}

/// Mensaje dentro de un match (MVP local; Stream Chat puede mapear attachments igual).
enum ChatMessageType {
  text
  image
  video
}

model ChatMessage {
  id            String          @id @default(uuid())
  matchId       String          @map("match_id")
  fromPetId     String          @map("from_pet_id")
  type          ChatMessageType @default(text)
  body          String          @default("")
  mediaUrl      String?         @map("media_url")
  mediaPublicId String?         @map("media_public_id")
  thumbnailUrl  String?         @map("thumbnail_url")
  durationSec   Int?            @map("duration_sec")
  createdAt     DateTime        @default(now()) @map("created_at")
  match         Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromPet       Pet             @relation("MessagesSent", fields: [fromPetId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([fromPetId])
  @@map("chat_messages")
}

/// Bloqueo entre usuarios (no se ven en discover ni chats).
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum ReportReason {
  spam
  harassment
  inappropriate
  fake
  other
}

/// Denuncia de un usuario hacia otro (revisión manual / futura).
model UserReport {
  id         String       @id @default(uuid())
  reporterId String       @map("reporter_id")
  reportedId String       @map("reported_id")
  reason     ReportReason
  details    String?
  matchId    String?      @map("match_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  reporter   User         @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId, createdAt])
  @@index([reporterId])
  @@map("user_reports")
}
